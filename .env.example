# Frontend (optional — dev proxy uses same origin)
# VITE_API_URL=

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5176

# Stripe (leave unset for mock checkout in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (leave unset for mock fulfillment)
PRINTFUL_API_KEY=

# Force mock modes even when keys are set
# MOCK_PAYMENTS=true
# MOCK_PRINTFUL=true

# Spotify playlist sync (npm run sync:playlist)
# Local:
#   1. Create an app at https://developer.spotify.com/dashboard
#   2. Add Redirect URI: http://127.0.0.1:3847/callback
#   3. Copy Client ID + Client Secret into this file or server/.env
#   4. One-time: npm run sync:playlist:auth --prefix server
#      (log in as the playlist owner/collaborator → copies refresh token)
#   5. npm run sync:playlist
#      → merges into src/data/playlistSongs.json (preserves curated themes/blurbs)
#
# Note: After Spotify's Feb 2026 API changes, Client Credentials alone cannot
# read playlist items. Use a refresh token for the owner/collaborator account.
#
# GitHub Action (.github/workflows/sync-playlist.yml):
#   1. Repo → Settings → Secrets and variables → Actions
#   2. Add secrets: SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REFRESH_TOKEN
#      (optional: SPOTIFY_PLAYLIST_ID to override the default playlist)
#   3. Actions → Sync Spotify playlist → Run workflow (or wait for daily cron).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional override (defaults to G.O.D. playlist)
# SPOTIFY_PLAYLIST_ID=3zweaDyE8UZiMdBAsPagxd
