# Frontend (optional — dev proxy uses same origin)
# VITE_API_URL=

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5176

# Stripe (leave unset for mock checkout in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (leave unset for mock fulfillment)
PRINTFUL_API_KEY=

# Force mock modes even when keys are set
# MOCK_PAYMENTS=true
# MOCK_PRINTFUL=true

# Spotify playlist sync (npm run sync:playlist)
# 1. Create an app at https://developer.spotify.com/dashboard (Client Credentials flow)
# 2. Paste Client ID / Secret below (also works in server/.env)
# 3. Run: npm run sync:playlist
# Optional: GitHub Action cron, a server job, or a Cursor automation on a schedule
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional override (defaults to G.O.D. playlist)
# SPOTIFY_PLAYLIST_ID=3zweaDyE8UZiMdBAsPagxd
