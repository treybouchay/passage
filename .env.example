# Frontend (optional — dev proxy uses same origin)
# VITE_API_URL=

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5176

# Stripe (leave unset for mock checkout in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (leave unset for mock fulfillment)
PRINTFUL_API_KEY=

# Force mock modes even when keys are set
# MOCK_PAYMENTS=true
# MOCK_PRINTFUL=true

# Spotify playlist sync (npm run sync:playlist)
# Local:
#   1. Create an app at https://developer.spotify.com/dashboard
#      (Client Credentials flow)
#   2. Copy Client ID + Client Secret into this file or server/.env
#      (server/.env wins if both exist)
#   3. Enable Web API on the app; if playlist reads return 403 Forbidden,
#      request Extended Access / Extended Quota Mode ("Request extension"),
#      keep the playlist Public, wait for approval, then sync again
#   4. Run from repo root: npm run sync:playlist
#      → merges into src/data/playlistSongs.json (preserves curated themes/blurbs)
#
# Optional owner token (if Client Credentials still 403 after Extended Quota):
#   Add Redirect URI http://127.0.0.1:3847/callback, then:
#   npm run sync:playlist:auth
#
# GitHub Action (.github/workflows/sync-playlist.yml):
#   1. Repo → Settings → Secrets and variables → Actions
#   2. Add secrets: SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET
#      (optional: SPOTIFY_PLAYLIST_ID, SPOTIFY_REFRESH_TOKEN)
#   3. Actions → Sync Spotify playlist → Run workflow (or wait for daily cron).
#      On change it commits playlistSongs.json.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_PLAYLIST_ID=3zweaDyE8UZiMdBAsPagxd
