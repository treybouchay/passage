# Frontend (optional — dev proxy uses same origin)
# VITE_API_URL=

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5176

# Stripe (leave unset for mock checkout in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (leave unset for mock fulfillment)
PRINTFUL_API_KEY=

# Force mock modes even when keys are set
# MOCK_PAYMENTS=true
# MOCK_PRINTFUL=true

# Spotify playlist sync (npm run sync:playlist)
# Development mode needs a user refresh token (Client Credentials often 403).
#
#   1. Create app at https://developer.spotify.com/dashboard — enable Web API
#   2. User Management → add your Spotify account
#   3. Settings → Redirect URIs → add http://127.0.0.1:8888/callback → Save
#   4. Set CLIENT_ID / CLIENT_SECRET below (or in server/.env — wins if both)
#   5. npm run auth:spotify  → copy SPOTIFY_REFRESH_TOKEN into .env
#   6. npm run sync:playlist
#
# GitHub Action: add secrets SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET,
# SPOTIFY_REFRESH_TOKEN (optional SPOTIFY_PLAYLIST_ID). Then re-run the Action.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_PLAYLIST_ID=3zweaDyE8UZiMdBAsPagxd

# Ticketmaster Discovery (song popup concerts). Free key:
# https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# Optional — a docs sample key is used as fallback in development.
TICKETMASTER_API_KEY=
